# Ignore everything by default.
/**

# Allow only the repository-owned shared assets.
!/.gitignore
!/AGENTS.md
!/README.md

!/.github/
!/.github/PULL_REQUEST_TEMPLATE.md

!/.agent/
!/.agent/skills/
!/.agent/skills/bootstrap-clever-work/
!/.agent/skills/bootstrap-clever-work/SKILL.md
!/.agent/skills/bootstrap-clever-work/agents/
!/.agent/skills/bootstrap-clever-work/agents/openai.yaml
!/.agent/skills/bootstrap-clever-work/scripts/
!/.agent/skills/bootstrap-clever-work/scripts/bootstrap_clever_work.py

!/docs/
!/docs/diagrams/
!/docs/diagrams/README.md
!/docs/diagrams/*.md
!/docs/diagrams/*.html
!/docs/guides/
!/docs/guides/clever-project-workflows.md
!/docs/guides/session-start-smoke-test.md
!/docs/guides/three-repo-startup-alignment.md
!/docs/setting.md
!/docs/superpowers/
!/docs/superpowers/plans/
!/docs/superpowers/plans/*.md
!/docs/superpowers/specs/
!/docs/superpowers/specs/*.md
!/docs/templates/
!/docs/templates/issue-edit-template.md
!/docs/templates/issue-resolution-context-wiki-prompt.md
!/docs/templates/main-pr-global-context-wiki-prompt.md
!/docs/templates/startup-branch-state-template.md
!/docs/templates/apply-target-repo-rulesets.sh
!/docs/templates/target-repo-AGENTS.md
!/docs/templates/target-repo-PULL_REQUEST_TEMPLATE.md
!/docs/templates/target-repo-project-brief.md

!/scripts/
!/scripts/sync_issue_from_md.py
!/scripts/bootstrap_clever_work.py

!/tests/
!/tests/test_bootstrap_clever_work.py
!/tests/test_gitignore_whitelist.py
!/tests/test_issue_resolution_context_wiki_prompt.py
!/tests/test_sync_issue_from_md.py

# Defense in depth for common local artifacts.
**/.DS_Store
**/__pycache__/
**/*.pyc
/.pytest_cache/
